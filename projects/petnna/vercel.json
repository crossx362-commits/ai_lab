{
  "buildCommand": "npm run build || true",
  "outputDirectory": ".",
  "_comment_ignoreCommand": "2026-07-26 제거됨. 'git diff --quiet HEAD^ HEAD -- . :!*.md :!docs/'로 문서 전용 커밋의 빌드를 아꼈는데, 이 판정은 마지막 커밋 하나(HEAD^..HEAD)만 본다. 푸시의 끝 커밋이 문서 전용이면 같은 푸시에 실린 실제 코드 변경까지 통째로 배포가 스킵됐다 — 실제로 건강 탭 카드 병합이 배포되지 않아 오너가 '안 합쳐졌는데'라고 지적했고, 저장소·로컬은 멀쩡한데 배포본만 4버전 뒤처져 있었다. 정적 사이트라 빌드 비용이 미미하니 항상 배포하는 쪽이 안전하다.",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/js/:file*", "destination": "/js/:file*" },
    { "source": "/css/:file*", "destination": "/css/:file*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cleanup-projects",
      "schedule": "0 6 * * *"
    }
  ]
}
