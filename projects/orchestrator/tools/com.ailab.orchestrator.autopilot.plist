<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  자율 운전 서비스 — 오너가 세울 때만 멈춘다(오너 지시 2026-09-12).
  세우기: ./orch stop  또는 보드 「세우기」 단추. 완전히 끄려면
          launchctl bootout gui/501/com.ailab.orchestrator.autopilot
  설치:   launchctl bootstrap gui/501 ~/Library/LaunchAgents/com.ailab.orchestrator.autopilot.plist
  PATH는 com.ailab.orchestrator.commands.plist와 같은 값을 쓴다(codex·claude·grok CLI 경로).
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ailab.orchestrator.autopilot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-m</string><string>orch_core.cli</string>
    <string>--target</string><string>ulon</string><string>autopilot</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/opt/homebrew/sbin:/Users/junholee/.grok/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/junholee/ai_lab/projects/orchestrator</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/junholee/ai_lab/projects/orchestrator/logs/autopilot.log</string>
  <key>StandardErrorPath</key><string>/Users/junholee/ai_lab/projects/orchestrator/logs/autopilot.log</string>
</dict></plist>
