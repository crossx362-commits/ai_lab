{
  "default_target": "sandbox",
  "max_attempts": 3,
  "unity_slots": 2,
  "unity_editor_template": "/Applications/Unity/Hub/Editor/{version}/Unity.app/Contents/MacOS/Unity",
  "ladder": [
    "codex",
    "astra"
  ],
  "research_agent": null,
  "log_summarizer": {
    "enabled": true,
    "model": "gemma4:12b",
    "min_chars": 4000,
    "unload_after": true
  },
  "targets": {
    "sandbox": {
      "repo": "sandbox",
      "unity_project": "sandbox",
      "unity_version": "6000.3.14f1",
      "allowed_write_globs": [
        "Assets/**"
      ],
      "protected_globs": [
        "Assets/Orch/**"
      ],
      "test_platforms": [
        "EditMode",
        "PlayMode"
      ],
      "test_guard_globs": [
        "Assets/Tests/**"
      ],
      "unity_timeout_sec": 600,
      "unity_stall_sec": 180
    },
    "blender_sandbox": {
      "kind": "blender",
      "repo": "blender_sandbox",
      "blender_check": "orch_check.py",
      "allowed_write_globs": [
        "build.py",
        "tests/**",
        "assets/**"
      ],
      "protected_globs": [
        "orch_check.py"
      ],
      "test_guard_globs": [
        "tests/**"
      ],
      "blender_timeout_sec": 300
    },
    "ulon": {
      "repo": "../..",
      "subdir": "projects/ulon",
      "unity_project": "../../projects/ulon/unity",
      "unity_version": "6000.3.14f1",
      "allowed_write_globs": [
        "unity/Assets/Game/**",
        "unity/Assets/StreamingAssets/**",
        "docs/**"
      ],
      "protected_globs": [
        "unity/Assets/Orch/**",
        "unity/Assets/Game/Scripts/Editor/SliceSelfCheck*.cs",
        "tools/**"
      ],
      "test_platforms": [],
      "test_guard_globs": [
        "unity/Assets/Game/Scripts/Editor/SliceSelfCheck*.cs",
        "unity/Assets/Tests/**"
      ],
      "gates": [
        {
          "name": "SliceSelfCheck",
          "execute_method": "Ulon.Editor.SliceSelfCheck.Run",
          "timeout_sec": 1800
        }
      ],
      "library_cache": true,
      "library_seed": "../../projects/ulon/unity/Library",
      "unity_timeout_sec": 1800,
      "unity_stall_sec": 300
    },
    "ulon_props": {
      "kind": "blender",
      "repo": "../..",
      "subdir": "projects/ulon/art/blender",
      "blender_check": "orch_check.py",
      "allowed_write_globs": [
        "build.py",
        "tests/**",
        "assets/**"
      ],
      "protected_globs": [
        "orch_check.py"
      ],
      "test_guard_globs": [
        "tests/**"
      ],
      "blender_timeout_sec": 300
    }
  },
  "agents": {
    "codex": {
      "type": "codex",
      "bin": "codex",
      "model": "gpt-5.6-sol",
      "extra_config": [
        "model_reasoning_effort=\"low\""
      ],
      "sandbox_mode": "workspace-write",
      "timeout_sec": 900,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "PLANNING",
        "REVIEW",
        "LOW_COST",
        "BLENDER"
      ]
    },
    "astra": {
      "type": "codex",
      "bin": "codex",
      "model": "gpt-5.6-sol",
      "extra_config": [
        "model_reasoning_effort=\"high\""
      ],
      "sandbox_mode": "workspace-write",
      "timeout_sec": 1800,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "PLANNING",
        "REVIEW",
        "LONG_CONTEXT",
        "BLENDER"
      ]
    },
    "claude": {
      "type": "claude",
      "enabled": true,
      "bin": "claude",
      "model": "opus",
      "permission_mode": "acceptEdits",
      "timeout_sec": 1800,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "REVIEW",
        "PLANNING",
        "LONG_CONTEXT"
      ]
    },
    "grok": {
      "type": "grok",
      "enabled": false,
      "bin": "grok",
      "model": null,
      "timeout_sec": 600,
      "capabilities": [
        "RESEARCH",
        "CODING"
      ]
    },
    "ollama": {
      "type": "ollama",
      "bin": "ollama",
      "model": "gemma4:12b",
      "timeout_sec": 300,
      "capabilities": [
        "LOCAL",
        "LOW_COST",
        "RESEARCH"
      ]
    }
  },
  "planner": "claude",
  "reviewer": "claude",
  "blender_bin": "/Applications/Blender.app/Contents/MacOS/Blender"
}
