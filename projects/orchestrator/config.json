{
  "default_target": "sandbox",
  "max_attempts": 3,
  "unity_slots": 2,
  "unity_editor_template": "/Applications/Unity/Hub/Editor/{version}/Unity.app/Contents/MacOS/Unity",
  "ladder": [
    "codex",
    "astra"
  ],
  "research_agent": null,
  "parallel_tasks": 2,
  "model_tiers": {
    "codex": [
      { "max_difficulty": 1, "model": "gpt-5.6-luna", "effort": "low" },
      { "max_difficulty": 2, "model": "gpt-5.6-terra", "effort": "low" },
      { "max_difficulty": 3, "model": "gpt-5.6-sol", "effort": "medium" },
      { "max_difficulty": 4, "model": "gpt-5.6-sol", "effort": "high" },
      { "max_difficulty": 5, "model": "gpt-6-astra", "effort": "high" }
    ],
    "claude": [
      { "max_difficulty": 1, "model": "haiku" },
      { "max_difficulty": 2, "model": "sonnet" },
      { "max_difficulty": 3, "model": "sonnet" },
      { "max_difficulty": 4, "model": "opus" },
      { "max_difficulty": 5, "model": "fable" }
    ]
  },
  "autopilot": {
    "target": "ulon",
    "goal": "울온(projects/ulon)의 docs/DEVELOPMENT_PLAN.md와 docs/GAME_DESIGN.md를 읽고, 아직 코드로 성립하지 않은 가장 높은 우선순위 항목 하나를 골라 구현 가능한 Task로 나눠라. 기존 코드와 미커밋 작업을 보존하고, 각 Task는 SliceSelfCheck 게이트로 검증 가능해야 한다.",
    "interval_sec": 60,
    "max_no_progress": 3
  },
  "log_summarizer": {
    "enabled": true,
    "model": "gemma4:12b",
    "min_chars": 4000,
    "unload_after": true
  },
  "targets": {
    "sandbox": {
      "repo": "sandbox",
      "unity_project": "sandbox",
      "unity_version": "6000.3.14f1",
      "allowed_write_globs": [
        "Assets/**"
      ],
      "protected_globs": [
        "Assets/Orch/**"
      ],
      "test_platforms": [
        "EditMode",
        "PlayMode"
      ],
      "test_guard_globs": [
        "Assets/Tests/**"
      ],
      "unity_timeout_sec": 600,
      "unity_stall_sec": 180
    },
    "blender_sandbox": {
      "kind": "blender",
      "repo": "blender_sandbox",
      "blender_check": "orch_check.py",
      "allowed_write_globs": [
        "build.py",
        "tests/**",
        "assets/**"
      ],
      "protected_globs": [
        "orch_check.py"
      ],
      "test_guard_globs": [
        "tests/**"
      ],
      "blender_timeout_sec": 300
    },
    "ulon": {
      "repo": "../..",
      "subdir": "projects/ulon",
      "unity_project": "../../projects/ulon/unity",
      "unity_version": "6000.3.14f1",
      "allowed_write_globs": [
        "unity/Assets/Game/**",
        "unity/Assets/StreamingAssets/**",
        "docs/**"
      ],
      "protected_globs": [
        "unity/Assets/Orch/**",
        "unity/Assets/Game/Scripts/Editor/SliceSelfCheck*.cs",
        "tools/**"
      ],
      "test_platforms": [],
      "test_guard_globs": [
        "unity/Assets/Game/Scripts/Editor/SliceSelfCheck*.cs",
        "unity/Assets/Tests/**"
      ],
      "gates": [
        {
          "name": "SliceSelfCheck",
          "execute_method": "Ulon.Editor.SliceSelfCheck.Run",
          "timeout_sec": 1800
        }
      ],
      "library_cache": true,
      "library_seed": "../../projects/ulon/unity/Library",
      "unity_timeout_sec": 1800,
      "unity_stall_sec": 300,
      "link_paths": [
        "server/.venv"
      ],
      "preflight": [
        {
          "name": "postgres(울온 persist 서버 전제)",
          "cmd": [
            "/opt/homebrew/bin/pg_isready",
            "-h",
            "127.0.0.1",
            "-p",
            "5432"
          ]
        }
      ]
    },
    "ulon_props": {
      "kind": "blender",
      "repo": "../..",
      "subdir": "projects/ulon/art/blender",
      "blender_check": "orch_check.py",
      "allowed_write_globs": [
        "build.py",
        "tests/**",
        "assets/**"
      ],
      "protected_globs": [
        "orch_check.py"
      ],
      "test_guard_globs": [
        "tests/**"
      ],
      "blender_timeout_sec": 300
    }
  },
  "agents": {
    "codex": {
      "type": "codex",
      "bin": "codex",
      "model": "gpt-5.6-sol",
      "extra_config": [
        "model_reasoning_effort=\"low\""
      ],
      "sandbox_mode": "workspace-write",
      "timeout_sec": 900,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "PLANNING",
        "REVIEW",
        "LOW_COST",
        "BLENDER"
      ]
    },
    "astra": {
      "type": "codex",
      "bin": "codex",
      "model": "gpt-5.6-sol",
      "extra_config": [
        "model_reasoning_effort=\"high\""
      ],
      "sandbox_mode": "workspace-write",
      "timeout_sec": 1800,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "PLANNING",
        "REVIEW",
        "LONG_CONTEXT",
        "BLENDER"
      ]
    },
    "claude": {
      "type": "claude",
      "enabled": true,
      "bin": "claude",
      "model": "opus",
      "permission_mode": "acceptEdits",
      "timeout_sec": 1800,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "REVIEW",
        "PLANNING",
        "LONG_CONTEXT"
      ]
    },
    "grok": {
      "type": "grok",
      "enabled": true,
      "bin": "grok",
      "model": null,
      "timeout_sec": 600,
      "capabilities": [
        "RESEARCH",
        "CODING"
      ]
    },
    "ollama": {
      "type": "ollama",
      "bin": "ollama",
      "model": "gemma4:12b",
      "timeout_sec": 300,
      "capabilities": [
        "LOCAL",
        "LOW_COST",
        "RESEARCH"
      ]
    }
  },
  "planner": "claude",
  "reviewer": "claude",
  "blender_bin": "/Applications/Blender.app/Contents/MacOS/Blender",
  "model_policy": {
    "codex": {
      "planning": "gpt-6-astra",
      "coding": "gpt-5.6-sol",
      "review": "gpt-6-astra",
      "debugging": "gpt-6-astra",
      "testing": "gpt-5.6-terra",
      "documentation": "gpt-5.6-luna"
    },
    "claude": {
      "planning": "fable",
      "coding": "sonnet",
      "review": "fable",
      "debugging": "opus",
      "testing": "sonnet",
      "documentation": "haiku"
    }
  }
}
