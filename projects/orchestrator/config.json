{
  "default_target": "sandbox",
  "max_attempts": 3,
  "unity_slots": 2,
  "unity_editor_template": "/Applications/Unity/Hub/Editor/{version}/Unity.app/Contents/MacOS/Unity",
  "ladder": [
    "codex",
    "claude",
    "astra"
  ],
  "research_agent": "grok",
  "log_summarizer": {
    "enabled": true,
    "model": "gemma4:12b",
    "min_chars": 4000,
    "unload_after": true
  },
  "targets": {
    "sandbox": {
      "repo": "sandbox",
      "unity_project": "sandbox",
      "unity_version": "6000.3.14f1",
      "allowed_write_globs": [
        "Assets/**"
      ],
      "protected_globs": [
        "Assets/Orch/**"
      ],
      "test_platforms": [
        "EditMode",
        "PlayMode"
      ],
      "test_guard_globs": [
        "Assets/Tests/**"
      ],
      "unity_timeout_sec": 600,
      "unity_stall_sec": 180
    }
  },
  "agents": {
    "codex": {
      "type": "codex",
      "bin": "codex",
      "model": null,
      "extra_config": [
        "model_reasoning_effort=\"low\""
      ],
      "sandbox_mode": "workspace-write",
      "timeout_sec": 900,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "PLANNING",
        "REVIEW",
        "LOW_COST"
      ]
    },
    "astra": {
      "type": "codex",
      "bin": "codex",
      "model": null,
      "extra_config": [
        "model_reasoning_effort=\"high\""
      ],
      "sandbox_mode": "workspace-write",
      "timeout_sec": 1800,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "PLANNING",
        "REVIEW",
        "LONG_CONTEXT"
      ]
    },
    "claude": {
      "type": "claude",
      "bin": "claude",
      "model": null,
      "permission_mode": "acceptEdits",
      "timeout_sec": 1800,
      "capabilities": [
        "CODING",
        "DEBUGGING",
        "REVIEW",
        "PLANNING",
        "LONG_CONTEXT"
      ]
    },
    "grok": {
      "type": "grok",
      "bin": "grok",
      "model": null,
      "timeout_sec": 600,
      "capabilities": [
        "RESEARCH",
        "CODING"
      ]
    },
    "ollama": {
      "type": "ollama",
      "bin": "ollama",
      "model": "gemma4:12b",
      "timeout_sec": 300,
      "capabilities": [
        "LOCAL",
        "LOW_COST",
        "RESEARCH"
      ]
    }
  },
  "planner": "astra",
  "reviewer": "astra"
}
