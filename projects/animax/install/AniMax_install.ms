/*
AniMax 설치 스크립트 (3ds Max 2025)
사용: 3ds Max 메뉴 Scripting > Run Script... 로 이 파일 실행 (또는 뷰포트에 드래그).
하는 일:
  1. 이 파일 위치를 기준으로 AniMax 패키지 경로를 찾는다.
  2. 사용자 startup 폴더에 AniMax_startup.ms 를 써서 Max 시작 때마다 매크로가 등록되게 한다.
  3. MacroScript "AniMax" (카테고리 AniMax) 를 즉시 정의한다 -> Customize UI 에서 툴바/단축키 배정.
  4. 바로 패널을 연다.
*/
(
	local thisFile = getSourceFileName()
	local installDir = getFilenamePath thisFile
	local pkgRoot = pathConfig.removePathLeaf (trimRight installDir "\\/")
	local pyRoot = substituteString pkgRoot "\\" "/"

	local macroBody = "macroScript AniMax category:\"AniMax\" tooltip:\"AniMax animation toolset\" buttonText:\"AniMax\"\n" + \
		"(\n" + \
		"    on execute do (\n" + \
		"        python.Execute (\"import sys\\nif '" + pyRoot + "' not in sys.path: sys.path.insert(0, '" + pyRoot + "')\\nimport importlib, animax.ui\\nanimax.ui.toggle()\")\n" + \
		"    )\n" + \
		")\n"
	local reloadBody = "macroScript AniMax_Reload category:\"AniMax\" tooltip:\"AniMax reload code (dev)\" buttonText:\"AniMax Reload\"\n" + \
		"(\n" + \
		"    on execute do (\n" + \
		"        python.Execute (\"import sys\\nif '" + pyRoot + "' not in sys.path: sys.path.insert(0, '" + pyRoot + "')\\nfor m in [k for k in list(sys.modules) if k.startswith('animax')]: del sys.modules[m]\\nimport animax.ui\\nanimax.ui.show()\")\n" + \
		"    )\n" + \
		")\n"

	-- startup 스크립트 기록
	local startupDir = (getDir #userStartupScripts)
	makeDir startupDir all:true
	local startupFile = startupDir + "\\AniMax_startup.ms"
	local f = createFile startupFile
	format "-- AniMax auto-generated by %: registers macros
" thisFile to:f
	format "%\n%\n" macroBody reloadBody to:f
	close f

	-- 즉시 정의 + 실행
	execute macroBody
	execute reloadBody
	macros.run "AniMax" "AniMax"
	format "AniMax 설치 완료. 패키지: %  / startup: %\n" pkgRoot startupFile
	if not (GetQuietMode()) do messageBox ("AniMax 설치 완료.\n\nCustomize > Customize User Interface > 카테고리 'AniMax' 에서\n툴바 버튼이나 단축키를 배정할 수 있다.\n\n패키지: " + pkgRoot) title:"AniMax"
)
