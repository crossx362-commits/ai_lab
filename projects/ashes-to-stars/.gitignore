# 재와 별 (Ashes to Stars) — 커밋하면 안 되는 것
#
# 기준: **재생성 가능한 것은 커밋하지 않는다.**
#   Library는 유니티가 에셋에서 다시 만들고(71MB),
#   _build*는 빌드하면 다시 나오며(각 120MB),
#   _logs는 실행할 때마다 갈아엎힌다.
# 소스(Assets·ProjectSettings·Packages)와 블렌더 스크립트·산출 스프라이트만 남긴다.

# ── 유니티가 재생성하는 것 ──────────────────────────────
unity/Library/
unity/Temp/
unity/Obj/
unity/obj/
unity/Build/
unity/Builds/
unity/Logs/
unity/UserSettings/
unity/MemoryCaptures/
unity/Recordings/
unity/.vsconfig
unity/*.csproj
unity/*.sln
unity/*.user

# ── 빌드 산출물 (각 120MB) ──────────────────────────────
_build/
_build_w2/
_build_w3/

# ── 실행 로그·측정 결과 (재실행하면 다시 나온다) ─────────
_logs/*.log
_logs/*.csv
_logs/*.png

# 단, 검증 결과 리포트는 output/qa/ashes-to-stars/ 에 따로 남는다 — 그건 추적한다

# ── 블렌더 중간 파일 ────────────────────────────────────
blender/*.blend1
blender/__pycache__/
