--- !u!114 &856470792
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 856470791}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 1547962512}
  m_Name: 
  m_EditorClassIdentifier: 
  "\uC81C\uBAA9": "\uC7AC\uC640 \uBCC4 \u2014 \uAC8C\uC784 \uC804\uCCB4 \uAD6C\uC870"
  "\uAE30\uD68D\uC11C": docs/GAME_DESIGN_ASHES_TO_STARS.md
  "\uC124\uBA85": "\uC774 \uC52C\uC740 \uAC8C\uC784\uC758 \uD654\uBA74 \uAD6C\uC870\uB97C
    \uD55C\uB208\uC5D0 \uBCF4\uB77C\uACE0 \uB9CC\uB4E0 \uAC83\uC774\uB2E4(\uD50C\uB808\uC774\uC6A9
    \uC544\uB2D8).\n\n\xB7 \uB9E8 \uC704      \uC804\uCCB4 \uD750\uB984\uB3C4 \u2014
    \uC601\uC9C0\uB97C \uC911\uC2EC\uC73C\uB85C \uCF58\uD150\uCE20\uAC00 \uC5B4\uB5BB\uAC8C
    \uC774\uC5B4\uC9C0\uB294\uAC00(\xA72)\n\xB7 \uADF8 \uC544\uB798    \uD654\uBA74
    10\uAC1C\uB97C \uACA9\uC790\uB85C \uBC30\uCE58. \uAC01 \uAD6C\uC5ED\uC758 \uC774\uB984
    \uC55E \uBC88\uD638\uAC00 \uC9C4\uD589 \uC21C\uC11C\n\n\uACC4\uCE35(Hierarchy)\uC5D0\uC11C
    \uAD6C\uC5ED\uC744 \uC811\uC5C8\uB2E4 \uD3B4\uBA70 \uBCF4\uB294 \uAC83\uC774
    \uAC00\uC7A5 \uD3B8\uD558\uB2E4.\n\uC218\uCE58\uB97C \uACE0\uCE58\uB824\uBA74
    Assets/_Game/Data/ \uC758 ScriptableObject\uB97C \uC778\uC2A4\uD399\uD130\uC5D0\uC11C
    \uC5F0\uB2E4.\n\n\uAC80\uC99D\uC6A9 \uC52C\uC740 \uBCC4\uB3C4: Assets/Scenes/W1(\uC131\uB2A5)\xB7W2(\uC870\uC791\uAC10)\xB7W3(\uD30C\uD2F0
    \uB300\uC870\uC2E4\uD5D8)"
