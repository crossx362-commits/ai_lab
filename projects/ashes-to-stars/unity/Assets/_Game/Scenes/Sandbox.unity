--- !u!114 &1570504918
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1570504917}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 1376058044}
  m_Name: 
  m_EditorClassIdentifier: 
  "\uC548\uB0B4": "\uC7AC\uC640 \uBCC4 \u2014 Sandbox \uC52C\n\n\uC5EC\uAE30 \uBCF4\uC774\uB294
    \uAC83:\n  Party      \uD45C\uC900 5\uC778 \uC9C4\uD615 (\uD0F1 \uC55E / \uB51C
    \uC911\uAC04 / \uD790\xB7\uBC84\uD37C \uB4A4)\n  Mobs_Sample \uACC4\uC5F4 5\uC885
    \xD7 AI 4\uC885 + \uC815\uC608 6\uC720\uD615\uC744 \uB298\uC5B4\uB193\uC740 \uAC83\n 
    Ground     \uBE14\uB80C\uB354\uC5D0\uC11C \uBCA0\uC774\uD06C\uD55C seamless \uB178\uC774\uC988
    \uBC14\uB2E5\n\n\uC218\uCE58\uB97C \uACE0\uCE58\uB824\uBA74 (\uD50C\uB808\uC774
    \uC5C6\uC774 \uC778\uC2A4\uD399\uD130\uC5D0\uC11C):\n  Assets/_Game/Data/GameBalance.asset 
    \u2014 \uACBD\uC81C \uC575\uCEE4\xB7\uC131\uB2A5 \uC608\uC0B0\n  Assets/_Game/Data/Jobs/             
    \u2014 \uC9C1\uC5C5 11\uC885 \uC2A4\uD0EF\xB7\uC2A4\uD0AC\n  Assets/_Game/Data/Races/            
    \u2014 \uC885\uC871 4\uC885 \uAE30\uC6B8\uAE30\n  Assets/_Game/Data/Mobs/             
    \u2014 \uBAAC\uC2A4\uD130 \uC18D\uB3C4\xB7\uCCB4\uB825\n  Assets/_Game/Data/Styles/           
    \u2014 \uC804\uD22C \uC2A4\uD0C0\uC77C 4\uC885\n\n\uAC80\uC99D \uC52C\uC740 \uB530\uB85C
    \uC788\uB2E4:\n  Assets/Scenes/W1  \uC131\uB2A5(500\uCCB4 60fps)\n  Assets/Scenes/W2 
    \uC870\uC791\uAC10(\uB300\uC2DC \uBB34\uC801)\n  Assets/Scenes/W3  \uD30C\uD2F0
    \uB300\uC870 \uC2E4\uD5D8\n\n\uCFFC\uD130\uBDF0 \uADDC\uCE59: \uC6D4\uB4DC y\uC5D0
    ISO_Y(0.5)\uB97C \uACF1\uD574 \uD654\uBA74\uC5D0 \uADF8\uB9B0\uB2E4.\n\uBE14\uB80C\uB354
    \uC2A4\uD504\uB77C\uC774\uD2B8\uB97C 30\xB0 \uD558\uAC15\uAC01\uC73C\uB85C \uB80C\uB354\uD588\uC73C\uBBC0\uB85C
    \uC774 \uAC12\uACFC \uB9DE\uC544\uC57C \uD55C\uB2E4."
