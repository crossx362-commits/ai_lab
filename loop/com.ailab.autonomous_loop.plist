<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ailab.autonomous_loop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/junholee/ai_lab/loop/loop.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/junholee/ai_lab</string>

    <!-- 로그인 시 자동 시작 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 비정상 종료(exit code != 0) 시에만 재시작, 정상 종료(0) 시에는 재시작 안 함 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- 터미널 환경변수 명시 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/junholee/.grok/bin:/Users/junholee/.cargo/bin</string>
        <key>HOME</key>
        <string>/Users/junholee</string>
        <key>USER</key>
        <string>junholee</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/junholee/ai_lab/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/junholee/ai_lab/logs/launchd_stderr.log</string>
</dict>
</plist>
