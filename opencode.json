{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "unity": {
      "type": "local",
      "command": [
        "/Users/junholee/.local/bin/uvx",
        "--offline",
        "--from",
        "mcpforunityserver==10.1.2",
        "mcp-for-unity"
      ],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": ["/Users/junholee/.local/bin/uvx", "blender-mcp"],
      "enabled": true,
      "environment": {
        "DISABLE_TELEMETRY": "true",
        "BLENDER_MCP_DISABLE_TELEMETRY": "true",
        "MCP_DISABLE_TELEMETRY": "true"
      }
    }
  }
}
